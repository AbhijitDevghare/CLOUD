# ============================================================================
# AI-Powered Unified Cloud & Application Security Platform - Environment Config
# ============================================================================

# --- Application & Server ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
PYTHON_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_SECRET=secplatform_internal_hmac_secret_change_in_prod_9f8a7b6c5d4e3f2a

# --- PostgreSQL Database ---
DATABASE_URL=postgresql://secadmin:secpassword@localhost:5432/cloud_sec_platform
PGHOST=localhost
PGPORT=5432
PGUSER=secadmin
PGPASSWORD=secpassword
PGDATABASE=cloud_sec_platform

# --- Redis (Queue, Rate-Limiting, Sliding-Window Counters & Blocklist) ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT & Authentication ---
JWT_ACCESS_SECRET=jwt_access_secret_key_change_in_production_min_32_chars_long_01
JWT_REFRESH_SECRET=jwt_refresh_secret_key_change_in_production_min_32_chars_long_02
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Credential Envelope Encryption (32-byte hex = 64 hex characters) ---
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Cloud Provider Integrations (Optional Default Fallbacks; Primarily Stored Encrypted per Account in DB) ---
AWS_DEFAULT_REGION=us-east-1
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# GCP_PROJECT_ID=

# --- AI & LLM Security Analysis Service ---
# Supported providers: openai | gemini | ollama | heuristic_fallback
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Threat Intelligence Feeds ---
ABUSEIPDB_API_KEY=

# --- Simulation / Sandbox Mode ---
# Keep false for real execution; set true ONLY when explicitly testing simulated cloud resources without live cloud credentials
ENABLE_DEMO_SIMULATION=false
